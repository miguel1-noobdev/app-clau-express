# MongoDB Connection
# Opción 1: MongoDB Local (Docker) - RECOMENDADO para desarrollo
# Primero correr: docker-compose up -d
MONGODB_URI=mongodb://claudapp:claudapp123@localhost:27017/claudapp?authSource=admin

# Opción 2: MongoDB Atlas (nube)
# Ir a https://cloud.mongodb.com/ y crear un cluster gratuito
# Copiar el connection string y reemplazar MONGODB_URI
# MONGODB_URI=mongodb://usuario:password@cluster.mongodb.net/claudapp?authSource=admin

# MongoDB Docker credentials (usados por docker-compose.yml)
MONGO_USER=claudapp
MONGO_PASSWORD=claudapp123

# Server Port
PORT=3000

# Session Secret (CAMBIAR en producción - usar string aleatorio de 64 chars)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-use-a-strong-random-secret

# Admin Bootstrap Password (requerido para crear el usuario admin inicial)
# Generar con: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ADMIN_PASSWORD=change-me-use-a-strong-random-password

# Google OAuth (Fase 5 - opcional por ahora)
# GOOGLE_CLIENT_ID=tu-client-id
# GOOGLE_CLIENT_SECRET=tu-client-secret
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Node Environment
NODE_ENV=development